---
import { getDisplayDate, type Post } from '../lib/pocketbase';
import { resolvePostImages, resolvePostVideoThumbnail } from '../lib/media';
import { isRequirementOwner } from '../lib/auth';

interface Props {
  post: Post;
  currentUser?: any;
}

const { post, currentUser } = Astro.props;
let images = resolvePostImages(post);
const firstImage = images[0] || null;
const imageCount = images.length;
const truncatedBody = post.body ? (post.body.length > 100 ? post.body.slice(0, 100) + '...' : post.body) : 'No description available.';
const author = post.author || 'Unknown Author';
const groupName = post.group_name || post.group_id || 'Facebook Group';
const postDate = getDisplayDate(post);
let postRouteId = post.facebook_post_id || post.temporary_id;
if (!postRouteId) {
  postRouteId = post.id?.startsWith('http') ? encodeURIComponent(post.id) : post.id;
}
const hasVideo = post.has_video || false;
const thumbnail = resolvePostVideoThumbnail(post) || firstImage || null;

console.log(`[DEBUG] Post ${post.id}:`);
console.log(`- currentUser:`, currentUser ? currentUser.id : 'null');
console.log(`- post.created_by:`, post.created_by);
console.log(`- post.expand?.created_by:`, post.expand?.created_by ? JSON.stringify(post.expand.created_by) : 'null');
console.log(`- Match?`, currentUser && post.expand?.created_by?.user === currentUser.id);

const actualSource = post.source || 'facebook';
const actualPostType = post.post_type || 'facebook';

---

<article 
  class="flex flex-col h-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-all hover:shadow-md cursor-pointer"
  onclick={`if(!event.target.closest('a, button, [role="button"]')) window.location.href='/posts/${postRouteId}'`}
>
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-slate-100 border-b border-slate-200">
    <div class="absolute top-2 left-2 flex gap-1.5 z-10">
      {actualPostType === 'requirement' && (
        <div class="rounded-md bg-blue-600 px-2.5 py-1 text-xs font-bold text-white shadow-sm">
          Requirement
        </div>
      )}
      {actualSource === 'website' && (
        <div class="rounded-md bg-slate-800 px-2.5 py-1 text-xs font-bold text-white shadow-sm">
          Website
        </div>
      )}
      {actualSource === 'facebook' && (
        <div class="rounded-md bg-[#1877F2] px-2.5 py-1 text-xs font-bold text-white shadow-sm">
          Facebook
        </div>
      )}
    </div>
    {hasVideo && thumbnail ? (
      <img 
        src={thumbnail} 
        alt={author + " video thumbnail"} 
        loading="lazy" 
        referrerpolicy="no-referrer"
        class="h-full w-full object-cover object-center transition-transform duration-300 hover:scale-105" 
      />
    ) : images.length > 0 ? (
      <img 
        src={firstImage} 
        alt={author + " post image"} 
        loading="lazy" 
        referrerpolicy="no-referrer"
        class="h-full w-full object-cover object-center transition-transform duration-300 hover:scale-105" 
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-slate-100 text-slate-400">
        <span class="text-sm font-medium">No Image</span>
      </div>
    )}
    
    {hasVideo && (
      <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/30 transition-colors pointer-events-none">
        <div class="h-12 w-12 rounded-full bg-white/90 shadow-lg flex items-center justify-center backdrop-blur-sm">
          <svg class="h-6 w-6 text-slate-900 ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>
    )}

    {imageCount > 1 && !hasVideo && (
      <div class="absolute bottom-2 right-2 rounded-md bg-black/70 px-2 py-1 text-xs font-semibold text-white backdrop-blur-sm">
        {imageCount} Photos
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col p-4">
    <p class="mb-4 flex-1 text-base text-slate-800 leading-relaxed line-clamp-4">
      {truncatedBody}
    </p>

    {(post.property_type || post.location || post.preferred_tenant || post.contact_number) && (
      <div class="mb-4 flex flex-wrap gap-1.5">
        {post.property_type && (
          <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-0.5 text-[10px] font-semibold text-blue-700 ring-1 ring-inset ring-blue-700/20">
            {post.property_type}
          </span>
        )}
        {post.location && (
          <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-0.5 text-[10px] font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-700/20">
            <svg class="mr-0.5 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            {post.location}
          </span>
        )}
        {post.preferred_tenant && (
          <span class="inline-flex items-center rounded-md bg-purple-50 px-2 py-0.5 text-[10px] font-semibold text-purple-700 ring-1 ring-inset ring-purple-700/20">
            {post.preferred_tenant}
          </span>
        )}
        {post.contact_number && (
          <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-700/20">
            <svg class="mr-0.5 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            {post.contact_number}
          </span>
        )}
      </div>
    )}

    <div class="flex flex-col gap-1 border-t border-slate-100 pt-3">
      <span class="font-semibold text-slate-900 text-xs truncate">{author}</span>
      <span class="text-[11px] text-slate-500">{postDate}</span>
    </div>

    <div class="mt-3 flex gap-2">
      <a 
        href={`/posts/${postRouteId}`} 
        class="inline-flex flex-1 items-center justify-center gap-1 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-slate-800 transition-colors shadow-sm"
      >
        <span>View Details</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      
      {isRequirementOwner(post, currentUser) && (
        <>
          <button 
            type="button"
            onclick={`event.stopPropagation(); window.editRequirement && window.editRequirement('${post.id}')`}
            class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors shadow-sm"
            title="Edit Requirement"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
          </button>
          <button 
            type="button"
            onclick={`event.stopPropagation(); window.deleteRequirement && window.deleteRequirement('${post.id}')`}
            class="inline-flex items-center justify-center rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 transition-colors shadow-sm"
            title="Delete Requirement"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        </>
      )}
    </div>
  </div>
  <div class="post-source-data hidden" data-source={actualSource}></div>
</article>
