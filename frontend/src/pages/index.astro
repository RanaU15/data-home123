---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import SkeletonCard from '../components/SkeletonCard.astro';
import { type Post } from '../lib/pocketbase';
import { getUser } from '../lib/auth';
import { getPostsPage, type PostFeed } from '../lib/data';

const { user } = await getUser(Astro);
const defaultAuthorName = user?.name || user?.email?.split('@')[0] || '';

const pageSize = 20;
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const requestedFeed = Astro.url.searchParams.get('feed') || 'all';
const feed: PostFeed = ['all', 'facebook', 'requirements', 'your'].includes(requestedFeed)
  ? requestedFeed as PostFeed
  : 'all';
const q = Astro.url.searchParams.get('q') || '';
const postPage = await getPostsPage({ feed, page: currentPage, perPage: pageSize, profileId: user?.profileId, query: q });
const posts = postPage.items as Post[];
const totalPosts = postPage.totalItems;
const totalPages = Math.max(1, postPage.totalPages);
const firstResult = totalPosts === 0 ? 0 : (postPage.page - 1) * postPage.perPage + 1;
const lastResult = totalPosts === 0 ? 0 : firstResult + posts.length - 1;
const error = postPage.error;

const hasPosts = posts && posts.length > 0;

function pageUrl(page: number) {
  const params = new URLSearchParams();
  if (page > 1) params.set('page', String(page));
  if (feed !== 'all') params.set('feed', feed);
  if (q) params.set('q', q);
  return `?${params.toString()}`;
}

const paginationItems: Array<number | 'ellipsis'> = [];
for (let page = 1; page <= totalPages; page++) {
  if (page === 1 || page === totalPages || Math.abs(page - currentPage) <= 1) {
    if (paginationItems.length > 0 && page - Number(paginationItems[paginationItems.length - 1]) > 1) {
      paginationItems.push('ellipsis');
    }
    paginationItems.push(page);
  }
}
---

<Layout title="Scraped Facebook Posts | Data Inspector">
  <div class="mb-8 border-b border-slate-200 pb-6">
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-6 xl:gap-8">
      <div class="relative w-full max-w-2xl">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input 
          type="text" 
          id="global-search-input"
          value={q}
          class="w-full h-[48px] md:h-[52px] pl-11 pr-24 rounded-full border border-slate-200 bg-white shadow-[0_2px_10px_-3px_rgba(0,0,0,0.05)] text-slate-900 placeholder-slate-400 focus:border-slate-300 focus:ring-4 focus:ring-slate-100 focus:outline-none transition-all text-sm md:text-base"
          placeholder="Search by location, property type..."
        />
        <div class="absolute inset-y-0 right-1.5 flex items-center">
          <button id="global-search-btn" class="h-9 md:h-10 px-5 bg-slate-900 text-white font-semibold rounded-full hover:bg-slate-800 transition-colors shadow-sm text-sm cursor-pointer">
            Search
          </button>
        </div>
      </div>
      <div class="flex-shrink-0 mt-2 xl:mt-0 flex flex-wrap items-center gap-4 xl:gap-6">
        <span id="last-updated-indicator" class="text-sm font-medium text-slate-500 hidden"></span>
        <span id="post-count-badge" class="inline-flex items-center rounded-full bg-white border border-slate-200 px-5 py-2 text-sm font-bold text-slate-800 shadow-sm" data-initial={totalPosts}>
          {totalPosts.toLocaleString()} Posts
        </span>
        {user ? (
          <button id="btn-open-requirement-modal" class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            Post Requirement
          </button>
        ) : (
          <a href="/login?redirect=/?action=post-requirement" class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            Post Requirement
          </a>
        )}
      </div>
    </div>
    
    <!-- Source Tabs -->
    <div class="mt-4 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-hide">
      <div class="flex shrink-0 items-center gap-2">
        <button class={`source-tab-btn px-4 py-2 rounded-full text-sm font-medium transition-colors ${feed === 'all' ? 'active bg-slate-900 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'}`} data-feed="all">All</button>
        <button class={`source-tab-btn px-4 py-2 rounded-full text-sm font-medium transition-colors ${feed === 'facebook' ? 'active bg-slate-900 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'}`} data-feed="facebook">Facebook</button>
        <button class={`source-tab-btn px-4 py-2 rounded-full text-sm font-medium transition-colors ${feed === 'requirements' ? 'active bg-slate-900 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'}`} data-feed="requirements">Requirements</button>
      </div>
      {user ? (
        <button id="btn-your-posts" class="ml-auto inline-flex shrink-0 items-center gap-2 rounded-full bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors">
          Your Posts
        </button>
      ) : (
        <a href="/login?redirect=/?action=your-posts" class="ml-auto inline-flex shrink-0 items-center gap-2 rounded-full bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors">
          Your Posts
        </a>
      )}
    </div>
  </div>

  <!-- Skeleton Loader (Shown while page/scripts initialize or if data is loading) -->
  <div id="skeleton-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 hidden">
    <SkeletonCard />
    <SkeletonCard />
    <SkeletonCard />
    <SkeletonCard />
    <SkeletonCard />
    <SkeletonCard />
    <SkeletonCard />
    <SkeletonCard />
  </div>

  <!-- Posts Grid -->
  <div id="posts-container">
    {hasPosts ? (
      <div>
        <div id="no-posts-msg" class="hidden flex-col items-center justify-center text-slate-400 py-12 bg-white rounded-xl border border-slate-200 mb-8">
          <svg class="w-16 h-16 mb-4 opacity-20" fill="currentColor" viewBox="0 0 24 24"><path d="M4 4h16v16H4z" opacity="0.2"/><path d="M4 2h16c1.1 0 2 .9 2 2v16c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2zm0 18h16V4H4v16zm11-11a2 2 0 110-4 2 2 0 010 4zM5.5 17h13l-4-5-3.5 4.5-2.5-3L5.5 17z"/></svg>
          <span class="font-medium text-lg text-slate-400">You haven't created any requirements yet.</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="results-grid">
          {posts.map((post: Post) => (
            <div class="post-wrapper h-full" data-post-type={post.post_type} data-created-by={post.created_by} data-body={[post.body, post.author, post.group_name, post.location, post.property_type, post.preferred_tenant, post.requirement, post.post_type].filter(Boolean).join(" ").toLowerCase()}>
              <PostCard post={post} currentUser={user} />
            </div>
          ))}
        </div>

        <!-- Pagination Controls -->
        {totalPosts > pageSize && <div class="mt-12 flex items-center justify-between border-t border-slate-200 pt-6">
          <div class="flex flex-1 items-center justify-between sm:hidden">
            <a 
              href={currentPage > 1 ? pageUrl(currentPage - 1) : '#'} 
              class={`relative inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 ${currentPage <= 1 ? 'pointer-events-none opacity-50' : ''}`}
            >
              Previous
            </a>
            <a 
              href={currentPage < totalPages ? pageUrl(currentPage + 1) : '#'} 
              class={`relative ml-3 inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 ${currentPage >= totalPages ? 'pointer-events-none opacity-50' : ''}`}
            >
              Next
            </a>
          </div>
          <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
            <div>
              <p class="text-sm text-slate-700">
                Showing <span class="font-medium">{firstResult}</span> to <span class="font-medium">{lastResult}</span> of <span class="font-medium">{totalPosts}</span> results
              </p>
            </div>
            <div>
              <nav class="inline-flex items-center gap-2" aria-label="Pagination">
                <a 
                  href={currentPage > 1 ? pageUrl(currentPage - 1) : '#'} 
                  class={`inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 shadow-sm transition-colors ${currentPage <= 1 ? 'pointer-events-none opacity-50' : ''}`}
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                  <span>Previous</span>
                </a>

                {paginationItems.map((item) => item === 'ellipsis' ? (
                  <span class="px-2 py-2 text-sm text-slate-500" aria-hidden="true">...</span>
                ) : (
                  <a
                    href={pageUrl(item)}
                    aria-current={item === currentPage ? 'page' : undefined}
                    class={`inline-flex min-w-9 items-center justify-center rounded-xl px-3 py-2 text-sm font-semibold transition-colors ${item === currentPage ? 'bg-slate-900 text-white' : 'border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 shadow-sm'}`}
                  >{item}</a>
                ))}

                <a 
                  href={currentPage < totalPages ? pageUrl(currentPage + 1) : '#'} 
                  class={`inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 shadow-sm transition-colors ${currentPage >= totalPages ? 'pointer-events-none opacity-50' : ''}`}
                >
                  <span>Next</span>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </nav>
            </div>
          </div>
        </div>}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center shadow-sm">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-blue-50 text-blue-600">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m6.75 12l-3-3m0 0l-3 3m3-3v6m-1.5-15H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-slate-900">No scraped posts available</h3>
        <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">
          The Supabase 'posts' table is currently empty or cannot be reached. Run your Facebook scraper to populate data.
        </p>
        {error && (
          <div class="mt-4 inline-flex items-center gap-1 text-xs text-rose-600 bg-rose-50 px-3 py-1 rounded-md border border-rose-200">
            <span>Error: {error.message}</span>
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Toast Notification -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2"></div>

  <!-- Post Requirement Modal -->
  <div id="requirement-modal" class="fixed inset-0 z-[100] hidden items-center justify-center">
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" id="requirement-modal-backdrop"></div>
    <div class="relative w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl m-4 transform transition-all max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-xl font-bold text-slate-900">Post Your Requirement</h3>
        <button id="btn-close-requirement-modal" class="text-slate-400 hover:text-slate-600 transition-colors">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <form id="requirement-form" class="space-y-4">
        <input type="hidden" id="req-edit-id" value="" />
        <div>
          <label for="req-author-name" class="block text-sm font-medium text-slate-700 mb-1">Your Name <span class="text-red-500">*</span></label>
          <input type="text" id="req-author-name" value={defaultAuthorName} required class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm placeholder-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition-all" placeholder="Enter your name" />
        </div>
        <div>
          <label for="req-body" class="block text-sm font-medium text-slate-700 mb-1">Requirement / Description <span class="text-red-500">*</span></label>
          <textarea id="req-body" required rows="4" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm placeholder-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition-all" placeholder="Example: I want a 2 BHK for my family in Vastrapur."></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="req-property-type" class="block text-sm font-medium text-slate-700 mb-1">Property Type</label>
            <select id="req-property-type" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition-all">
              <option value="">Any</option>
              <option value="1 BHK">1 BHK</option>
              <option value="2 BHK">2 BHK</option>
              <option value="3 BHK">3 BHK</option>
              <option value="4 BHK">4 BHK</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="relative">
            <label for="req-location" class="block text-sm font-medium text-slate-700 mb-1">Location</label>
            <input type="text" id="req-location" autocomplete="off" aria-autocomplete="list" aria-controls="location-suggestions" aria-expanded="false" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm placeholder-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition-all" placeholder="E.g., Vastrapur" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">Purpose / Tenant</label>
          <div class="grid grid-cols-2 gap-3" id="req-purpose-group">
            <label class="cursor-pointer">
              <input type="checkbox" value="Looking for Flat" class="req-purpose-cb peer sr-only" />
              <div class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-600 transition-all peer-checked:border-blue-600 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:font-semibold hover:bg-slate-50 text-center shadow-sm flex items-center justify-center">Looking for Flat</div>
            </label>
            <label class="cursor-pointer">
              <input type="checkbox" value="Looking for Tenant" class="req-purpose-cb peer sr-only" />
              <div class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-600 transition-all peer-checked:border-blue-600 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:font-semibold hover:bg-slate-50 text-center shadow-sm flex items-center justify-center">Looking for Tenant</div>
            </label>
            <label class="cursor-pointer">
              <input type="checkbox" value="Family" class="req-purpose-cb peer sr-only" />
              <div class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-600 transition-all peer-checked:border-blue-600 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:font-semibold hover:bg-slate-50 text-center shadow-sm flex items-center justify-center">Family</div>
            </label>
            <label class="cursor-pointer">
              <input type="checkbox" value="Bachelors" class="req-purpose-cb peer sr-only" />
              <div class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-600 transition-all peer-checked:border-blue-600 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:font-semibold hover:bg-slate-50 text-center shadow-sm flex items-center justify-center">Bachelors</div>
            </label>

            <label class="cursor-pointer">
              <input type="checkbox" value="Office" class="req-purpose-cb peer sr-only" />
              <div class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-600 transition-all peer-checked:border-blue-600 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:font-semibold hover:bg-slate-50 text-center shadow-sm flex items-center justify-center">Office</div>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t border-slate-100">
          <div>
            <label for="req-contact-number" class="block text-sm font-medium text-slate-700 mb-1">Contact Number (Optional)</label>
            <input type="text" id="req-contact-number" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm placeholder-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:outline-none transition-all" placeholder="e.g., +91 9876543210" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Photos (Max 5)</label>
            <div class="relative">
              <input type="file" id="req-photos" accept="image/jpeg, image/png, image/webp" multiple class="hidden" />
              <button type="button" id="btn-add-photos" class="inline-flex items-center gap-2 rounded-xl bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 transition-colors shadow-sm w-full justify-center">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                + Add Photos
              </button>
            </div>
          </div>
        </div>
        
        <div id="req-photo-previews" class="flex flex-wrap gap-2 empty:hidden pt-2"></div>
        <div id="req-error-msg" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600 border border-red-100"></div>
        <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-slate-100">
          <button type="button" id="btn-cancel-requirement" class="rounded-xl px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-100 transition-colors">Cancel</button>
          <button type="submit" id="btn-submit-requirement" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors disabled:opacity-70 disabled:cursor-not-allowed">
            Post Requirement
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { pb } from '../lib/pocketbase';
    import { resolvePostImages } from '../lib/media';

    document.addEventListener("DOMContentLoaded", () => {
      const skeletonGrid = document.getElementById("skeleton-grid");
      const postsContainer = document.getElementById("posts-container");
      if (skeletonGrid && postsContainer && !window.sessionStorage.getItem("initial_loaded")) {
        skeletonGrid.classList.remove("hidden");
        postsContainer.classList.add("hidden");
        setTimeout(() => {
          skeletonGrid.classList.add("hidden");
          postsContainer.classList.remove("hidden");
          window.sessionStorage.setItem("initial_loaded", "true");
        }, 500);
      }

      const searchInput = document.getElementById("global-search-input") as HTMLInputElement;
      const searchBtn = document.getElementById("global-search-btn");
      const badge = document.getElementById("post-count-badge");
      let debounceTimer: ReturnType<typeof setTimeout>;

      const sourceTabBtns = document.querySelectorAll('.source-tab-btn');
      const btnYourPosts = document.getElementById('btn-your-posts');
      const navigateToFeed = (feed: string) => {
        const url = new URL(window.location.href);
        url.searchParams.set('feed', feed);
        url.searchParams.set('page', '1');
        window.location.assign(url.toString());
      };

      if (btnYourPosts) btnYourPosts.addEventListener('click', () => navigateToFeed('your'));
      sourceTabBtns.forEach(btn => {
        btn.addEventListener('click', () => navigateToFeed(btn.getAttribute('data-feed') || 'all'));
      });

      // Status Polling and Auto-Refresh Logic
      const lastUpdatedIndicator = document.getElementById("last-updated-indicator");
      let currentLastSync: string | null = null;
      let refreshTimer: ReturnType<typeof setTimeout> | undefined;

      function scheduleFeedRefresh() {
        if (refreshTimer) clearTimeout(refreshTimer);
        refreshTimer = setTimeout(() => performSearch(true), 150);
      }

      function formatSyncTimes(lastSyncUtc: string, nextSyncUtc: string) {
        const formatter = new Intl.DateTimeFormat("en-IN", {
          timeZone: "Asia/Kolkata",
          hour: "numeric",
          minute: "2-digit",
          hour12: true
        });

        const lastD = new Date(lastSyncUtc);
        const nextD = new Date(nextSyncUtc);

        const lastTime = isNaN(lastD.getTime()) ? "" : formatter.format(lastD);
        const nextTime = isNaN(nextD.getTime()) ? "" : formatter.format(nextD);

        // Check if today in IST
        const todayIST = new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata' }).format(new Date());
        const targetIST = new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata' }).format(lastD);

        const datePrefix = todayIST === targetIST ? "Today" : new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', month: 'short', day: 'numeric' }).format(lastD);
        return `Updated ${datePrefix} ${lastTime} | Next Update ${nextTime}`;
      }

      async function checkSyncStatus() {
        try {
          const res = await fetch('/api/sync.json?_t=' + new Date().getTime());
          if (res.ok) {
            const data = await res.json();
            if (data.last_sync_utc && data.next_sync_utc) {
              if (lastUpdatedIndicator) {
                lastUpdatedIndicator.textContent = formatSyncTimes(data.last_sync_utc, data.next_sync_utc);
                lastUpdatedIndicator.classList.remove("hidden");
              }

              if (currentLastSync && currentLastSync !== data.last_sync_utc) {
                // Production server reached a new scheduled sync period
                scheduleFeedRefresh();
              }
              currentLastSync = data.last_sync_utc;
            }
          }
        } catch (e) {
          // ignore error
        }
      }

      // Check immediately and then every 10 seconds
      checkSyncStatus();
      setInterval(checkSyncStatus, 10000);

      pb.collection('posts').subscribe('*', scheduleFeedRefresh).catch((error) => {
        console.error('Posts realtime subscription failed', error);
      });

      async function performSearch(forceRefresh = false) {
        if (!searchInput) return;
        
        const rawQuery = searchInput.value || "";
        const url = new URL(window.location.href);
        
        if (!forceRefresh) {
          if (rawQuery.trim()) {
            url.searchParams.set('q', rawQuery.trim());
            url.searchParams.set('page', '1');
          } else {
            url.searchParams.delete('q');
            url.searchParams.set('page', '1');
          }
        } else {
          // Add cache-buster to ensure we get fresh HTML from server
          url.searchParams.set('_t', new Date().getTime().toString());
        }

        // Show loading state
        if (skeletonGrid && postsContainer) {
          skeletonGrid.classList.remove("hidden");
          postsContainer.classList.add("hidden");
        }

        try {
          const response = await fetch(url.toString());
          const html = await response.text();
          
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          
          const newPostsContainer = doc.getElementById('posts-container');
          const newBadge = doc.getElementById('post-count-badge');
          
          if (postsContainer && newPostsContainer) {
            postsContainer.innerHTML = newPostsContainer.innerHTML;
          }

          if (badge && newBadge) {
            badge.textContent = newBadge.textContent;
          }

          window.history.pushState({}, '', url.toString());
        } catch (e) {
          console.error("Search failed", e);
        } finally {
          if (skeletonGrid && postsContainer) {
            skeletonGrid.classList.add("hidden");
            postsContainer.classList.remove("hidden");
          }
        }
      }

      function handleInput() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => performSearch(false), 300);
      }

      if (searchInput) {
        searchInput.addEventListener("input", () => {
          handleInput();
        });
      }
      
      if (searchBtn) {
        searchBtn.addEventListener("click", () => {
          performSearch(false);
        });
      }

      // ----------------------------------------------------
      // Post Requirement Modal Logic
      // ----------------------------------------------------
      const btnOpenReq = document.getElementById('btn-open-requirement-modal');
      const modalReq = document.getElementById('requirement-modal');
      const btnCloseReq = document.getElementById('btn-close-requirement-modal');
      const btnCancelReq = document.getElementById('btn-cancel-requirement');
      const formReq = document.getElementById('requirement-form');
      const backdropReq = document.getElementById('requirement-modal-backdrop');
      const reqErrorMsg = document.getElementById('req-error-msg');
      const btnSubmitReq = document.getElementById('btn-submit-requirement') as HTMLButtonElement;
      
      const reqPhotosInput = document.getElementById('req-photos') as HTMLInputElement;
      const btnAddPhotos = document.getElementById('btn-add-photos');
      const photoPreviews = document.getElementById('req-photo-previews');
      
      let selectedFiles: File[] = [];
      let existingPhotos: string[] = []; // for edit mode, URLs of photos to keep

      const locationInput = document.getElementById('req-location') as HTMLInputElement;
      const locationSuggestions = document.createElement('div');
      locationSuggestions.id = 'location-suggestions';
      locationSuggestions.setAttribute('role', 'listbox');
      locationSuggestions.className = 'fixed hidden overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl';
      locationSuggestions.style.zIndex = '120';
      document.body.appendChild(locationSuggestions);

      type LocationSuggestion = { display_name: string };
      let locationResults: LocationSuggestion[] = [];
      let highlightedLocationIndex = -1;
      let locationSearchTimer: ReturnType<typeof setTimeout> | undefined;
      let locationSearchController: AbortController | undefined;
      let locationSearchSequence = 0;

      function positionLocationSuggestions() {
        if (!locationInput || locationSuggestions.classList.contains('hidden')) return;
        const rect = locationInput.getBoundingClientRect();
        locationSuggestions.style.left = `${rect.left}px`;
        locationSuggestions.style.top = `${rect.bottom + 4}px`;
        locationSuggestions.style.width = `${rect.width}px`;
      }

      function closeLocationSuggestions() {
        clearTimeout(locationSearchTimer);
        locationSearchController?.abort();
        locationSearchSequence++;
        locationSuggestions.classList.add('hidden');
        locationInput?.setAttribute('aria-expanded', 'false');
        highlightedLocationIndex = -1;
      }

      function renderLocationSuggestions(message?: string, loading = false) {
        locationSuggestions.innerHTML = '';
        locationSuggestions.classList.remove('hidden');
        locationInput?.setAttribute('aria-expanded', 'true');

        if (loading) {
          locationSuggestions.innerHTML = '<div class="px-4 py-3 text-sm text-slate-500">Searching locations...</div>';
          positionLocationSuggestions();
          return;
        }

        if (message) {
          locationSuggestions.innerHTML = `<div class="px-4 py-3 text-sm text-slate-500">${message}</div>`;
          positionLocationSuggestions();
          return;
        }

        locationResults.forEach((result, index) => {
          const option = document.createElement('button');
          option.type = 'button';
          option.setAttribute('role', 'option');
          option.className = 'block w-full border-b border-slate-100 px-4 py-3 text-left text-sm text-slate-700 last:border-b-0 hover:bg-blue-50';
          option.textContent = result.display_name;
          option.addEventListener('pointerdown', (event) => {
            event.preventDefault();
            locationInput.value = result.display_name;
            closeLocationSuggestions();
          });
          option.addEventListener('mouseenter', () => {
            highlightedLocationIndex = index;
            updateHighlightedLocation();
          });
          locationSuggestions.appendChild(option);
        });
        locationSuggestions.insertAdjacentHTML('beforeend', '<div class="px-4 py-1.5 text-[10px] text-slate-400">© OpenStreetMap contributors</div>');
        positionLocationSuggestions();
      }

      function updateHighlightedLocation() {
        Array.from(locationSuggestions.querySelectorAll('[role="option"]')).forEach((option, index) => {
          option.classList.toggle('bg-blue-50', index === highlightedLocationIndex);
          option.setAttribute('aria-selected', index === highlightedLocationIndex ? 'true' : 'false');
        });
      }

      async function searchLocations(query: string, sequence: number) {
        locationSearchController?.abort();
        const controller = new AbortController();
        locationSearchController = controller;
        const makeUrl = (indiaOnly: boolean) => {
          const params = new URLSearchParams({
            format: 'jsonv2',
            addressdetails: '1',
            limit: '8',
            q: query,
            'accept-language': 'en'
          });
          if (indiaOnly) params.set('countrycodes', 'in');
          return `https://nominatim.openstreetmap.org/search?${params.toString()}`;
        };

        try {
          let response = await fetch(makeUrl(true), {
            signal: controller.signal,
            headers: { Accept: 'application/json' }
          });
          let results = response.ok ? await response.json() as LocationSuggestion[] : [];

          if (results.length === 0) {
            response = await fetch(makeUrl(false), {
              signal: controller.signal,
              headers: { Accept: 'application/json' }
            });
            results = response.ok ? await response.json() as LocationSuggestion[] : [];
          }

          if (sequence !== locationSearchSequence) return;
          locationResults = results.slice(0, 8);
          highlightedLocationIndex = -1;
          renderLocationSuggestions(locationResults.length ? undefined : 'No locations found');
        } catch (error) {
          if ((error as Error).name !== 'AbortError' && sequence === locationSearchSequence) {
            renderLocationSuggestions('Unable to search locations');
          }
        }
      }

      function scheduleLocationSearch() {
        clearTimeout(locationSearchTimer);
        locationSearchSequence++;
        const sequence = locationSearchSequence;
        const query = locationInput?.value.trim() || '';
        locationResults = [];
        highlightedLocationIndex = -1;

        if (query.length < 2) {
          locationSearchController?.abort();
          closeLocationSuggestions();
          return;
        }

        renderLocationSuggestions(undefined, true);
        locationSearchTimer = setTimeout(() => searchLocations(query, sequence), 400);
      }

      if (locationInput) {
        locationInput.addEventListener('input', scheduleLocationSearch);
        locationInput.addEventListener('keydown', (event) => {
          const optionCount = locationResults.length;
          if (event.key === 'ArrowDown' && optionCount > 0) {
            event.preventDefault();
            highlightedLocationIndex = (highlightedLocationIndex + 1) % optionCount;
            updateHighlightedLocation();
          } else if (event.key === 'ArrowUp' && optionCount > 0) {
            event.preventDefault();
            highlightedLocationIndex = highlightedLocationIndex <= 0 ? optionCount - 1 : highlightedLocationIndex - 1;
            updateHighlightedLocation();
          } else if (event.key === 'Enter' && highlightedLocationIndex >= 0) {
            event.preventDefault();
            locationInput.value = locationResults[highlightedLocationIndex].display_name;
            closeLocationSuggestions();
          } else if (event.key === 'Escape') {
            closeLocationSuggestions();
          }
        });
      }

      document.addEventListener('pointerdown', (event) => {
        const target = event.target as Node;
        if (target !== locationInput && !locationSuggestions.contains(target)) closeLocationSuggestions();
      });
      window.addEventListener('resize', positionLocationSuggestions);
      window.addEventListener('scroll', positionLocationSuggestions, true);
      
      if (btnAddPhotos && reqPhotosInput) {
        btnAddPhotos.addEventListener('click', () => reqPhotosInput.click());
      }
      
      if (reqPhotosInput) {
        reqPhotosInput.addEventListener('change', (e) => {
          const files = Array.from((e.target as HTMLInputElement).files || []);
          if (selectedFiles.length + existingPhotos.length + files.length > 5) {
            showToast("Maximum 5 photos allowed.", true);
            return;
          }
          
          files.forEach(file => {
            if (['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
              selectedFiles.push(file);
            }
          });
          renderPhotoPreviews();
          reqPhotosInput.value = ''; // reset
        });
      }

      function renderPhotoPreviews() {
        if (!photoPreviews) return;
        photoPreviews.innerHTML = '';
        
        // Render existing photos (for edit mode)
        existingPhotos.forEach((url, idx) => {
          const div = document.createElement('div');
          div.className = 'relative w-16 h-16 rounded-md overflow-hidden border border-slate-200 group';
          div.innerHTML = `
            <img src="${url}" class="w-full h-full object-cover" />
            <button type="button" class="absolute inset-0 bg-black/50 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" data-remove-existing="${idx}">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          `;
          photoPreviews.appendChild(div);
        });
        
        // Render new files
        selectedFiles.forEach((file, idx) => {
          const div = document.createElement('div');
          div.className = 'relative w-16 h-16 rounded-md overflow-hidden border border-slate-200 group';
          const objectUrl = URL.createObjectURL(file);
          div.innerHTML = `
            <img src="${objectUrl}" class="w-full h-full object-cover" />
            <button type="button" class="absolute inset-0 bg-black/50 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" data-remove-new="${idx}">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          `;
          photoPreviews.appendChild(div);
        });
        
        // Attach remove listeners
        photoPreviews.querySelectorAll('[data-remove-existing]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-remove-existing') || '0', 10);
            existingPhotos.splice(idx, 1);
            renderPhotoPreviews();
          });
        });
        
        photoPreviews.querySelectorAll('[data-remove-new]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-remove-new') || '0', 10);
            selectedFiles.splice(idx, 1);
            renderPhotoPreviews();
          });
        });
      }

      function showToast(message: string, isError = false) {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `px-4 py-3 rounded-xl shadow-lg text-sm font-medium text-white transform transition-all translate-y-full opacity-0 flex items-center gap-2 ${isError ? 'bg-red-600' : 'bg-slate-900'}`;
        toast.innerHTML = isError ? 
          `<svg class="h-5 w-5 text-red-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>${message}` : 
          `<svg class="h-5 w-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>${message}`;
        container.appendChild(toast);
        
        // Animate in
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-full', 'opacity-0');
        });
        
        // Remove after 3s
        setTimeout(() => {
          toast.classList.add('translate-y-full', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }

      function openRequirementModal(isEdit = false) {
        if (modalReq) {
          if (!isEdit) {
            if (formReq) (formReq as HTMLFormElement).reset();
            closeLocationSuggestions();
            const editIdEl = document.getElementById('req-edit-id') as HTMLInputElement;
            if (editIdEl) editIdEl.value = '';
            selectedFiles = [];
            existingPhotos = [];
            renderPhotoPreviews();
            if (btnSubmitReq) btnSubmitReq.innerHTML = 'Post Requirement';
            modalReq.querySelector('h3')!.textContent = 'Post Your Requirement';
          }
          
          modalReq.classList.remove('hidden');
          modalReq.classList.add('flex');
          // small delay for transition
          setTimeout(() => {
            const inner = modalReq.querySelector('.transform');
            inner?.classList.add('scale-100');
          }, 10);
        }
      }

      function closeRequirementModal() {
        if (modalReq) {
          closeLocationSuggestions();
          modalReq.classList.add('hidden');
          modalReq.classList.remove('flex');
          if (formReq) (formReq as HTMLFormElement).reset();
          if (reqErrorMsg) reqErrorMsg.classList.add('hidden');
          selectedFiles = [];
          existingPhotos = [];
          renderPhotoPreviews();
        }
      }
      
      // EXPOSE TO WINDOW FOR PostCard.astro Buttons

      (window as any).editRequirement = async (postId: string) => {
        try {
          const post = await pb.collection('posts').getOne(postId);
          openRequirementModal(true);
          
          // Pre-fill
          (document.getElementById('req-edit-id') as HTMLInputElement).value = post.id;
          (document.getElementById('req-author-name') as HTMLInputElement).value = post.author || '';
          (document.getElementById('req-body') as HTMLTextAreaElement).value = post.body || '';
          (document.getElementById('req-property-type') as HTMLSelectElement).value = post.property_type || '';
          (document.getElementById('req-location') as HTMLInputElement).value = post.location || '';
          (document.getElementById('req-contact-number') as HTMLInputElement).value = post.contact_number || '';
          
          // Tenant checkboxes
          const tenant = post.preferred_tenant || '';
          document.querySelectorAll('.req-purpose-cb').forEach((cb: any) => {
            cb.checked = tenant.includes(cb.value);
          });
          
          // Photos
          existingPhotos = resolvePostImages(post);
          selectedFiles = [];
          renderPhotoPreviews();
          
          if (btnSubmitReq) btnSubmitReq.innerHTML = 'Update Requirement';
          modalReq!.querySelector('h3')!.textContent = 'Edit Your Requirement';
        } catch(e) {
          showToast("Error loading requirement for edit.", true);
        }
      };

      (window as any).deleteRequirement = async (postId: string) => {
        if (confirm("Are you sure you want to delete this requirement?")) {
          try {
            const res = await fetch('/api/requirements?id=' + postId, { method: 'DELETE' });
            if (!res.ok) throw new Error('Forbidden');
            showToast("Requirement deleted successfully.");
            scheduleFeedRefresh();
          } catch(e) {
            showToast("Failed to delete requirement (403 Forbidden).", true);
          }
        }
      };

      if (btnOpenReq) btnOpenReq.addEventListener('click', () => openRequirementModal(false));
      if (btnCloseReq) btnCloseReq.addEventListener('click', closeRequirementModal);
      if (btnCancelReq) btnCancelReq.addEventListener('click', closeRequirementModal);
      if (backdropReq) backdropReq.addEventListener('click', closeRequirementModal);

      // Check URL for action
      const urlParams = new URLSearchParams(window.location.search);
      const actionParam = urlParams.get('action');
      if (actionParam === 'post-requirement' || actionParam === 'your-posts') {
        // Must be logged in to reach here properly with action via our button logic
        if (document.body.getAttribute('data-user-id')) {
          if (actionParam === 'post-requirement') {
            openRequirementModal();
          } else if (actionParam === 'your-posts' && btnYourPosts) {
            navigateToFeed('your');
          }
          if (actionParam === 'post-requirement') {
            urlParams.delete('action');
            const newUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
            window.history.replaceState({}, document.title, newUrl);
          }
        }
      }

      if (formReq) {
        formReq.addEventListener('submit', async (e) => {
          e.preventDefault();
          const bodyEl = document.getElementById('req-body') as HTMLTextAreaElement;
          const propTypeEl = document.getElementById('req-property-type') as HTMLSelectElement;
          const locEl = document.getElementById('req-location') as HTMLInputElement;
          const purposeCbs = document.querySelectorAll('.req-purpose-cb:checked');
          const preferred_tenant = Array.from(purposeCbs).map(cb => (cb as HTMLInputElement).value).join(', ');
          const authorNameEl = document.getElementById('req-author-name') as HTMLInputElement;
          const contactNumberEl = document.getElementById('req-contact-number') as HTMLInputElement;
          const editIdEl = document.getElementById('req-edit-id') as HTMLInputElement;
          
          const body = bodyEl?.value.trim();
          if (!body) {
            if (reqErrorMsg) {
              reqErrorMsg.textContent = "Please enter your requirement.";
              reqErrorMsg.classList.remove('hidden');
            }
            return;
          }

          if (btnSubmitReq) {
            btnSubmitReq.disabled = true;
            btnSubmitReq.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Saving...`;
          }
          if (reqErrorMsg) reqErrorMsg.classList.add('hidden');

          try {
            const isEdit = !!editIdEl.value;
            
            if (isEdit) {
               // Update via PocketBase JS SDK directly
               // Extract existing image filenames from URLs to pass to PocketBase if they haven't been removed
               // Actually PocketBase expects filenames in an array to KEEP them, or we just don't touch them if we don't need to.
               // Wait, PocketBase file update: to remove a file you just send it as null, or in v0.22 you pass the remaining filenames in the `migrated_images` field array.
               // Since `existingPhotos` has full URLs, let's parse filenames:
               const existingFileNames = existingPhotos.map(url => {
                 const parts = new URL(url).pathname.split('/');
                 return parts[parts.length - 1];
               });
               
               const fd = new FormData();
               fd.append('body', body);
               fd.append('property_type', propTypeEl?.value || '');
               fd.append('location', locEl?.value || '');
               fd.append('preferred_tenant', preferred_tenant);
               fd.append('author', authorNameEl?.value || '');
               fd.append('contact_number', contactNumberEl.value || '');
               
               // In PB > 0.17 to keep existing files when updating multiple file field, you pass the existing filenames as strings
               // along with new File objects.
               if (existingFileNames.length === 0 && selectedFiles.length === 0) {
                 fd.append('migrated_images', ''); // Clear all files
               } else {
                 existingFileNames.forEach(name => fd.append('migrated_images', name));
                 selectedFiles.forEach(file => fd.append('migrated_images', file));
               }
               
               const res = await fetch('/api/requirements?id=' + editIdEl.value, {
                 method: 'PUT',
                 body: fd
               });
               if (!res.ok) throw new Error('Failed to update requirement');
               
               closeRequirementModal();
               showToast("Requirement updated successfully.");
               scheduleFeedRefresh();
            } else {
               // Create via API Route
               const formData = new FormData();
               formData.append('body', body);
               formData.append('property_type', propTypeEl?.value || '');
               formData.append('location', locEl?.value || '');
               formData.append('preferred_tenant', preferred_tenant);
               formData.append('author_name', authorNameEl?.value || '');
               formData.append('contact_number', contactNumberEl.value || '');
               
               selectedFiles.forEach(file => {
                 formData.append('photos', file);
               });
               
               const res = await fetch('/api/requirements', {
                 method: 'POST',
                 body: formData
               });
  
               const data = await res.json();
               if (!res.ok) throw new Error(data.error || 'Failed to post requirement');
  
               closeRequirementModal();
               showToast("Requirement posted successfully.");
               scheduleFeedRefresh();
            }
          } catch (err: any) {
            if (reqErrorMsg) {
              reqErrorMsg.textContent = err.message || "Failed to save requirement. Please try again.";
              reqErrorMsg.classList.remove('hidden');
            }
          } finally {
            if (btnSubmitReq) {
              btnSubmitReq.disabled = false;
              btnSubmitReq.innerHTML = editIdEl.value ? 'Update Requirement' : 'Post Requirement';
            }
          }
        });
      }
    });
  </script>
</Layout>
